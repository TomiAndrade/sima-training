# Puerto del servidor HTTP
PORT=3000

# Conexión a PostgreSQL (local vía docker-compose en el Paso 2)
DATABASE_URL="postgresql://sima:sima@localhost:5432/sima_training?schema=public"

# Secreto para firmar JWT (auth básica, Paso 6)
JWT_SECRET="cambiar-en-produccion"
JWT_EXPIRES_IN="8h"

# Credenciales del backoffice (Sprint 1: login simple sin roles, contra estas
# credenciales de entorno; migra a Usuario+Vinculacion en sprints futuros).
AUTH_USER="admin@sima.com"
AUTH_PASSWORD="sima1234"

# Orígenes permitidos por CORS (frontends)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Raíz del storage de archivos subidos (imágenes de preguntas). Se sirve en
# /uploads. Solo vale para desarrollo local: LocalDiskStorage es la única
# implementación hoy, pero el contenedor de un deploy es efímero (no hay
# disco persistente en el plan free de Render), así que ahí hace falta
# object storage (S3/R2) — ver src/storage/ y docs/pendientes.md.
UPLOADS_DIR="./uploads"

# Siembra el escenario de demo navegable además del seed base (organizaciones
# cliente/subcontratista, alumnos con pares, banco clasificado, un módulo
# publicado y asignaciones automáticas). Apagado por defecto: son datos de
# demostración, no estructura. Se suele pasar en la línea del comando y no acá:
#   PowerShell:  $env:SEED_DEMO='true'; npx prisma db seed
#   bash:        SEED_DEMO=true npx prisma db seed
# SEED_DEMO=true
