# Puerto del servidor HTTP
PORT=3000

# Conexión a PostgreSQL (local vía docker-compose en el Paso 2)
DATABASE_URL="postgresql://sima:sima@localhost:5432/sima_training?schema=public"

# Secreto para firmar JWT. Ya no lo usa el backoffice (login real es Auth0,
# ver abajo) — lo sigue usando la app tablet para sus propios tokens
# (`tipo: 'alumno'`, TabletService/TabletAuthGuard).
JWT_SECRET="cambiar-en-produccion"
JWT_EXPIRES_IN="8h"

# Orígenes permitidos por CORS (frontends)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- Auth0 (Story 4) ---
#
# JwtAuthGuard valida tokens RS256 de Auth0 contra su JWKS. Es el único
# mecanismo de login del backoffice — ver src/auth/jwt-auth.guard.ts.
#
# AUTH0_DOMAIN: el dominio del tenant (ej. tu-tenant.us.auth0.com), sin
# https:// ni slash final — el guard arma https://${AUTH0_DOMAIN}/ como
# issuer y .well-known/jwks.json para las claves.
AUTH0_DOMAIN=""
# AUTH0_AUDIENCE: el identifier de la API que creaste en el dashboard.
AUTH0_AUDIENCE=""

# DSN de Sentry (reporte de errores 5xx, con el requestId como tag). Vacío =
# Sentry desactivado, sin romper nada — así arranca en desarrollo local y en
# los tests, sin necesitar cuenta.
SENTRY_DSN=""

# --- Storage de archivos subidos (imágenes de preguntas) ---
#
# Qué implementación de StorageService se usa:
#   local = disco de la propia máquina (LocalDiskStorage). Sirve en desarrollo.
#   r2    = Cloudflare R2. Obligatorio en cualquier deploy: el contenedor es
#           efímero (no hay disco persistente en el plan free de Render), así
#           que con `local` el primer redeploy borra todas las imágenes y la
#           base queda con claves que no apuntan a nada.
STORAGE_DRIVER="local"

# Solo con STORAGE_DRIVER=local. Se sirve bajo /uploads.
UPLOADS_DIR="./uploads"

# Solo con STORAGE_DRIVER=r2. Los tres primeros salen del panel de R2:
#   R2_ACCOUNT_ID  → "Account Details → Account ID" (también está en la URL del
#                    dashboard). Con él se arma el endpoint S3:
#                    https://<account-id>.r2.cloudflarestorage.com
#   Las dos claves → "Account Details → API Tokens → Manage", creando una
#                    **Account API token** con permiso "Object Read & Write"
#                    acotada al bucket. El Secret se muestra UNA sola vez.
# Nunca commitear valores reales acá: este archivo SÍ está en git, .env no.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="sima-training"

# Login de la app tablet (Story 5), PROVISIONAL sin PIN — ver
# docs/autenticacion-tablet.md. En 'false' el endpoint POST /tablet/login
# responde 501 en vez de aceptar login sólo con DNI.
TABLET_LOGIN_SIN_PIN="true"
# Vencimiento del token de la tablet: corto a propósito, es la sesión de un
# atril compartido, no la de una persona con su propio dispositivo.
TABLET_JWT_EXPIRES_IN="2h"

# Siembra el contenido real de SIMA CHECK además del seed base: los catálogos de
# nómina, las 3 bases de conocimiento con su escala, las 202 preguntas de los
# cinco Excel de evaluación con sus 73 imágenes, los 5 módulos publicados y las
# reglas de asignación. NO siembra personas (la nómina es PII y se importa desde
# el backoffice). Apagado por defecto: es contenido, no estructura. Se suele
# pasar en la línea del comando y no acá:
#   PowerShell:  $env:SEED_SIMA_CHECK='true'; npx prisma db seed
#   bash:        SEED_SIMA_CHECK=true npx prisma db seed
# SEED_SIMA_CHECK=true
