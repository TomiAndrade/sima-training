// Prisma schema — SIMA Training API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tipo de organización dentro de la jerarquía cliente → subcontratista.
enum TipoOrganizacion {
  CLIENTE
  SUBCONTRATISTA
  INTERNA
}

// Rol de la vinculación persona↔organización. Vivió transitoriamente en
// Usuario hasta que se implementó Vinculacion (ver README.md, Sprint 5).
enum RolUsuario {
  ADMINISTRADOR
  COORDINADOR
  AUDITOR
  ALUMNO
}

// Organizacion: clientes y subcontratistas. La jerarquía se modela con una
// FK self-referencial (un subcontratista cuelga de un cliente).
model Organizacion {
  id                  Int              @id @default(autoincrement())
  nombre              String
  tipo                TipoOrganizacion @default(CLIENTE)
  organizacionPadreId Int?             @map("organizacion_padre_id")
  activa              Boolean          @default(true)

  // Relación self-referencial
  organizacionPadre Organizacion?  @relation("OrganizacionJerarquia", fields: [organizacionPadreId], references: [id])
  subcontratistas   Organizacion[] @relation("OrganizacionJerarquia")

  vinculaciones Vinculacion[]

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@map("organizaciones")
}

// Usuario: identidad pura de cualquier persona (cuenta de sistema y/o persona
// evaluada). Rol, organización y clasificación se movieron a Vinculacion
// (ver README.md, Sprint 5); acá solo queda lo que identifica
// a la persona en sí.
model Usuario {
  id       Int     @id @default(autoincrement())
  nombre   String
  apellido String
  dni      String  @unique
  email    String?

  vinculacion Vinculacion?

  asignaciones Asignacion[]
  sesiones     Sesion[]

  // Datos flexibles de nómina (jsonb). Dato de tránsito: los campos que se
  // estabilicen cuando llegue el Excel real se promueven a columnas (§3.4-a).
  datos Json @default("{}")

  // Trazabilidad
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  // Soft-delete (Sprint 1 implementa la baja que el prototipo no tiene).
  deletedAt DateTime? @map("deleted_at")

  @@map("usuarios")
}

// Tipo de pregunta. Mapeo con los tipos que ya usa el frontend mockeado
// (sima-check/data/training-modules.js):
//   truefalse     -> VERDADERO_FALSO
//   multiple      -> OPCION_MULTIPLE
//   image-options -> OPCIONES_IMAGEN
// TEXTO_LIBRE no tiene equivalente en el mock; se agrega a futuro.
enum TipoPregunta {
  VERDADERO_FALSO
  OPCION_MULTIPLE
  OPCIONES_IMAGEN
  TEXTO_LIBRE
}

enum EstadoVersionModulo {
  BORRADOR
  ACTIVO
  ARCHIVADO
}

// Origen de una Asignacion: la derivó recalcular() a partir de una regla, o la
// cargó un admin a mano. recalcular() sólo crea/revoca las AUTOMATICA — nunca
// toca las MANUAL.
enum OrigenAsignacion {
  AUTOMATICA
  MANUAL
}

// Origen de un ModuloVersionPregunta: lo materializó resolverCriterios() a partir
// de un ModuloVersionCriterio, o lo eligió un admin a mano desde el banco. Es un
// enum PROPIO y no OrigenAsignacion: comparte la idea (derivado vs. manual) y la
// regla (resolver criterios nunca toca las MANUAL), pero no los valores — acá el
// derivado es CRITERIO, no AUTOMATICA.
enum OrigenPregunta {
  CRITERIO
  MANUAL
}

// Pregunta: única, puede pertenecer a varios módulos (vía ModuloVersionPregunta).
// Nunca se duplica el texto de una pregunta.
model Pregunta {
  id                String       @id @default(uuid())
  texto             String
  tipo              TipoPregunta
  // Opciones (OPCION_MULTIPLE / OPCIONES_IMAGEN): array de strings (texto o rutas de imagen).
  opciones          Json?
  // Equivalente a `correctAnswer` del mock. Nullable: TEXTO_LIBRE puede no tener una fija.
  respuestaCorrecta String?      @map("respuesta_correcta")
  // Ruta relativa a public/, equivalente al campo `image` del mock.
  imagen            String?
  puntajeMax        Int?         @map("puntaje_max")
  activa            Boolean      @default(true)

  // Clasificación: el TEMA (base) y la DIFICULTAD (nivel dentro de esa base).
  // Nullable en la base de datos aunque el formulario de alta las exija: el
  // banco ya tenía preguntas cargadas cuando esto se agregó y no hay forma de
  // derivar la base del texto. El filtro ?sinBase=true es lo que permite ir
  // limpiando ese backlog.
  baseConocimientoId String? @map("base_conocimiento_id")
  nivelId            String? @map("nivel_id")
  // De qué manual salió ESTA pregunta. Se autocompleta con la `fuente` vigente
  // de la base al crearla y después no se toca: la base dice de dónde sale el
  // temario hoy, la pregunta de dónde salió ella. Sin esto, actualizar la
  // fuente de la base al salir un manual nuevo haría que las preguntas viejas
  // ya desactivadas muestren el manual que las dejó obsoletas.
  fuente             String?

  base  BaseConocimiento? @relation(fields: [baseConocimientoId], references: [id], onDelete: Restrict)
  // FK COMPUESTA: con esto la base de datos garantiza que el nivel pertenece a
  // la base de la pregunta, sin chequeo en el service. Corre bajo MATCH SIMPLE,
  // así que con nivel_id NULL no se evalúa — eso es deseado ("base cargada,
  // nivel pendiente"). El caso inverso (nivel sin base) lo tapa un CHECK
  // escrito a mano en la migración, que Prisma no conoce.
  nivel NivelBase?        @relation(fields: [nivelId, baseConocimientoId], references: [id, baseConocimientoId], onDelete: Restrict)

  versiones  ModuloVersionPregunta[]
  respuestas Respuesta[]

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@map("preguntas")
}

// BaseConocimiento: la taxonomía temática del banco de preguntas ("Gestión de
// residuos", "Trabajo en altura"). Reemplaza a la vieja Etiqueta: en vez de un
// N a N de tags libres y opcionales, es UNA sola base por pregunta, con una
// escala de niveles propia.
//
// NO SE VERSIONA, a propósito: es una taxonomía, no contenido. "Gestión de
// residuos" como materia es la misma en 2020 y en 2026 — lo que cambia es qué
// se considera correcto dentro de ella. Cuando sale un manual nuevo se mandan a
// papelera las preguntas obsoletas, se cargan las nuevas en la MISMA base y se
// publica una ModuloVersion nueva; los dos mecanismos de versionado que ya
// existen alcanzan. Crear una base nueva por manual ("Gestión de Residuos
// 2026") está descartado: parte las estadísticas justo en el eje que se quiere
// medir. El año/revisión sale de `fuente`, nunca del nombre.
model BaseConocimiento {
  id          String  @id @default(uuid())
  nombre      String  @unique @db.VarChar(120)
  codigo      String? @unique @db.VarChar(20)
  // Qué entra y qué no en esta base. No es decorativo: es lo que permite
  // decidir sin dudar a cuál de dos bases parecidas va una pregunta nueva.
  descripcion String?
  // De qué manual/revisión sale el temario HOY ("Manual de Gestión de Residuos
  // Rev. 4 — 03/2026"). Se copia a Pregunta.fuente al crear una pregunta y ahí
  // queda congelada: la base dice de dónde sale el temario hoy, la pregunta de
  // dónde salió ella.
  fuente      String?
  color       String? @db.VarChar(7)
  // Orden de display del catálogo (alfabético rara vez es el útil).
  orden       Int?
  activa      Boolean @default(true)

  niveles   NivelBase[]
  preguntas Pregunta[]
  criterios ModuloVersionCriterio[]

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@map("bases_conocimiento")
}

// NivelBase: la escala de dificultad de una base. Es ORDINAL (una escala, no
// una bolsa de subtemas) y es una TABLA y no un enum porque la escala es POR
// BASE: una base puede necesitar 3 niveles y otra 5.
model NivelBase {
  id                 String @id @default(uuid())
  baseConocimientoId String @map("base_conocimiento_id")
  nombre             String @db.VarChar(60)
  // Lo que hace que sea una escala y no una bolsa. Es ORDINAL: lo único que
  // significa es cuál va antes que cuál, NO que la numeración sea contigua.
  // Borrar el nivel del medio deja un hueco (0, 2) y está bien: eliminarNivel()
  // no reindexa a propósito — el orden relativo no cambia y no vale meterle una
  // transacción con SQL crudo a cada borrado. Consecuencia a tener presente:
  // siguienteOrden() usa max(orden)+1, así que borrar y agregar repetido hace
  // subir los números sin que vuelvan a bajar. reordenarNiveles() es lo único
  // que renumera, y de paso normaliza los huecos que haya.
  //
  // Reordenar NO se hace con updates fila por fila: el @@unique de abajo no es
  // diferible y se viola a mitad de camino. Ver reordenarNiveles() en el
  // service — reindexa toda la escala en dos pasadas.
  orden              Int

  base      BaseConocimiento        @relation(fields: [baseConocimientoId], references: [id], onDelete: Restrict)
  preguntas Pregunta[]
  criterios ModuloVersionCriterio[]

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([baseConocimientoId, nombre])
  @@unique([baseConocimientoId, orden])
  // No es una unicidad de negocio (`id` ya es PK): existe para habilitar la FK
  // COMPUESTA de Pregunta — (nivel_id, base_conocimiento_id) → (id,
  // base_conocimiento_id) —, con la que la base de datos garantiza que el nivel
  // de una pregunta pertenece a su base, sin chequeo en el service.
  @@unique([id, baseConocimientoId])
  @@map("niveles_base")
}

// Módulo: contenedor estable de versiones. El contenido real (preguntas)
// vive en ModuloVersion, nunca acá directamente.
model Modulo {
  id            String  @id @default(uuid())
  nombre        String  @db.VarChar(200)
  descripcion   String?
  // Baja lógica del módulo entero (independiente del ciclo BORRADOR/ACTIVO/ARCHIVADO
  // de sus versiones): el admin lo retira/reactiva a mano.
  activo        Boolean @default(true)
  // Cada cuántos meses un alumno debe rendir de nuevo este módulo para seguir
  // certificado. Nullable: módulos sin cadencia de recertificación definida.
  vigenciaMeses Int?    @map("vigencia_meses")

  versiones        ModuloVersion[]
  reglasAsignacion ReglaAsignacion[]
  asignaciones     Asignacion[]

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@map("modulos")
}

// Versión de un módulo. Editar un módulo activo crea una versión nueva;
// las versiones anteriores quedan ARCHIVADO e inmutables (no se pierden).
model ModuloVersion {
  id            String              @id @default(uuid())
  moduloId      String              @map("modulo_id")
  // Contador monotónico interno (orden de creación). El número público es anio.mayor.menor.
  numeroVersion Int                 @map("numero_version")
  estado        EstadoVersionModulo @default(BORRADOR)

  // Número público AÑO.MAYOR.MENOR (ej. 2026.01.00). Se asigna al Activar (publicar);
  // un BORRADOR sin publicar los tiene en null y se muestra como "Borrador".
  // MAYOR = secuencia por módulo por año; MENOR = revisión dentro de esa línea.
  anio         Int?      @map("anio")
  mayor        Int?
  menor        Int?
  // Timestamp de publicación (para ordenar el historial).
  activadaEn   DateTime? @map("activada_en")
  // Elección guardada en el borrador: true = versión nueva (sube MAYOR), false = actualización
  // (sube MENOR). null para v1 / primera publicación (no hay de qué derivar).
  esNuevaLinea Boolean?  @map("es_nueva_linea")

  // CÓMO SE RINDE esta versión. Los cuatro son nullable y `null` significa "usar
  // el default global" (3 preguntas / 70% / sin tope de intentos / sin espera),
  // NUNCA cero: es lo que deja convivir las versiones ya publicadas sin backfill
  // y sin reinterpretar lo que en su momento eran constantes del backend.
  //
  // Viven acá y no en Modulo (donde está vigenciaMeses) porque se congelan con la
  // versión: sólo se editan en BORRADOR y crearVersion() los copia del ACTIVO.
  // Cambiar el umbral de un módulo publicado es publicar una versión nueva.
  preguntasPorExamen         Int? @map("preguntas_por_examen")
  // En PORCENTAJE (1-100). El fallback es UMBRAL_APROBACION_DEFAULT (corregir.ts)
  // y se congela por intento en Sesion.umbralAprobacion, así que subirlo mañana no
  // reescribe los certificados ya emitidos.
  umbralAprobacion           Int? @map("umbral_aprobacion")
  // Tope de intentos y espera mínima entre uno y otro. Se cuentan por MÓDULO
  // (todas sus versiones) y el contador se resetea al aprobar — ver reintentos.ts.
  maxIntentos                Int? @map("max_intentos")
  esperaEntreIntentosMinutos Int? @map("espera_entre_intentos_minutos")

  modulo       Modulo                  @relation(fields: [moduloId], references: [id])
  preguntas    ModuloVersionPregunta[]
  criterios    ModuloVersionCriterio[]
  asignaciones Asignacion[]
  sesiones     Sesion[]

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@unique([moduloId, numeroVersion])
  @@unique([moduloId, anio, mayor, menor])
  @@map("modulo_versiones")
}

// Puesto: catálogo de puestos/cargos de nómina. Baja lógica vía `activo`.
model Puesto {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  vinculaciones    VinculacionPuestoCentro[]
  reglasAsignacion ReglaAsignacion[]

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@map("puestos")
}

// CentroCosto: catálogo de centros de costo de nómina. Baja lógica vía `activo`.
model CentroCosto {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  vinculaciones    VinculacionPuestoCentro[]
  reglasAsignacion ReglaAsignacion[]

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@map("centros_costo")
}

// Vinculacion: vínculo persona ↔ organización (una por usuario — el @unique
// en usuarioId es la regla "una sola organización" verificada por Postgres).
// Guarda lo que es único por persona: organización y rol. Puesto y centro de
// costo se repiten y van siempre juntos: viven apareados en VinculacionPuestoCentro.
// Reemplaza a Usuario.rol/organizacionId y al concepto de "clasificación"
// (que se elimina: la pertenencia SIMA/CLIENTE/SUBCONTRATISTA se deriva de
// Organizacion.tipo + organizacionPadreId, no se persiste acá).
// Ver README.md, Sprint 5.
model Vinculacion {
  id Int @id @default(autoincrement())

  usuarioId Int     @unique @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  organizacionId Int          @map("organizacion_id")
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  rol RolUsuario

  puestosCentros VinculacionPuestoCentro[]

  activa Boolean @default(true)

  // Trazabilidad
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  @@map("vinculaciones")
}

// Un par (puesto, centro de costo) que la persona ejerce dentro de su vinculación.
// Los tres campos de la PK son NOT NULL: un par siempre viene completo — nunca un
// puesto sin centro ni al revés. Reemplaza a VinculacionPuesto + VinculacionCentroCosto,
// que modelaban puesto y centro como ejes independientes: la capacitación obligatoria
// depende del par ("Soldador en YPF" ≠ "Soldador en PAE"), no de dos listas sueltas.
// Por eso el mismo puesto en varios centros SÍ es una fila por centro.
// Ver README.md, Sprint 5.
model VinculacionPuestoCentro {
  vinculacionId Int    @map("vinculacion_id")
  puestoId      String @map("puesto_id")
  centroCostoId String @map("centro_costo_id")

  vinculacion Vinculacion @relation(fields: [vinculacionId], references: [id])
  puesto      Puesto      @relation(fields: [puestoId], references: [id])
  centroCosto CentroCosto @relation(fields: [centroCostoId], references: [id])

  // Cuál par se muestra como "el" puesto/centro del usuario en listados/tablas.
  // Exactamente UNO en true por vinculación, garantizado por un índice único PARCIAL
  // (UNIQUE (vinculacion_id) WHERE principal AND activo) que vive solo en la migración:
  // Prisma no puede expresar un @@unique con WHERE. El `activo` del predicado es
  // load-bearing: sin él, un par principal ya desactivado ocupa el único lugar y
  // bloquea promover otro. Ver docs/pendientes.md.
  principal Boolean @default(false)
  activo    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@id([vinculacionId, puestoId, centroCostoId])
  // Índices invertidos: la regla de asignación filtra por el par exacto entrando por
  // cualquiera de los dos ejes. El `map` es explícito porque el nombre autogenerado
  // pasa el límite de 63 caracteres de Postgres y Prisma lo truncaría.
  @@index([puestoId, centroCostoId, vinculacionId], map: "vinculacion_puesto_centro_puesto_centro_idx")
  @@index([centroCostoId, puestoId, vinculacionId], map: "vinculacion_puesto_centro_centro_puesto_idx")
  @@map("vinculacion_puesto_centro")
}

// Pivot ModuloVersion <-> Pregunta (N a N), con orden y obligatoriedad.
model ModuloVersionPregunta {
  moduloVersionId String         @map("modulo_version_id")
  preguntaId      String         @map("pregunta_id")
  orden           Int
  obligatoria     Boolean        @default(true)
  // Baja lógica por módulo: una pregunta no se edita, se desactiva. Solo afecta
  // a este módulo (el banco Pregunta.activa sigue siendo el flag global).
  activa          Boolean        @default(true)
  // Por qué está esta pregunta en el módulo: la trajo un ModuloVersionCriterio
  // (CRITERIO) o la eligió un admin a mano desde el banco (MANUAL).
  // resolverCriterios() sólo crea/borra las CRITERIO — las MANUAL son las que
  // permiten seguir agregando preguntas encima de lo que trajo el criterio.
  // Default MANUAL, que es la verdad de todos los pivots previos a la Entrega B:
  // se cargaron uno por uno desde el banco.
  origen          OrigenPregunta @default(MANUAL)

  moduloVersion ModuloVersion @relation(fields: [moduloVersionId], references: [id])
  pregunta      Pregunta      @relation(fields: [preguntaId], references: [id])

  @@id([moduloVersionId, preguntaId])
  @@map("modulo_version_preguntas")
}

// ModuloVersionCriterio: QUÉ evalúa una versión de módulo, declarado como
// (base de conocimiento, nivel opcional) en vez de una lista de preguntas
// sueltas. "SIMA Básico = Seguridad Operativa-Básico + Residuos-Básico".
//
// Una versión puede declarar VARIOS niveles de la misma base (son criterios
// distintos), y `nivelId` NULL significa "cualquier nivel de esta base".
//
// NO guarda cuántas preguntas sortear: el pool se materializa ENTERO en
// ModuloVersionPregunta (origen=CRITERIO) y el sorteo por examen todavía no
// existe (la tablet toma 3 fijas y no lee el backend). Ver docs/pendientes.md.
//
// SNAPSHOT, no receta viva: los pivots se materializan al guardar los criterios
// sobre un BORRADOR y activar() los congela sin volver a resolver. Si el criterio
// se resolviera al rendir, una versión ARCHIVADO sería un puntero a un pozo que
// se mueve por debajo y no se podría reconstruir qué se pudo tomar en una fecha
// — que es todo el motivo del versionado del Sprint 3.
model ModuloVersionCriterio {
  id                 String  @id @default(uuid())
  moduloVersionId    String  @map("modulo_version_id")
  // NOT NULL: un criterio sin tema no significa nada. Por eso acá NO hace falta
  // el CHECK `nivel_requiere_base` que sí lleva Pregunta — el agujero de MATCH
  // SIMPLE que ese CHECK tapa (nivel cargado con base NULL) no se puede dar.
  baseConocimientoId String  @map("base_conocimiento_id")
  // NULL = cualquier nivel de esa base.
  nivelId            String? @map("nivel_id")

  moduloVersion ModuloVersion    @relation(fields: [moduloVersionId], references: [id], onDelete: Restrict)
  base          BaseConocimiento @relation(fields: [baseConocimientoId], references: [id], onDelete: Restrict)
  // FK COMPUESTA, igual que en Pregunta: la base de datos garantiza que el nivel
  // del criterio pertenece a su base, sin chequeo en el service (un findFirst
  // previo no sobrevive a dos escrituras concurrentes). Se apoya en el
  // @@unique([id, baseConocimientoId]) de NivelBase, que existe para esto.
  nivel         NivelBase?       @relation(fields: [nivelId, baseConocimientoId], references: [id, baseConocimientoId], onDelete: Restrict)

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  // OJO: este @@unique cubre SÓLO los criterios con nivel. Con nivel_id NULL,
  // Postgres considera cada fila distinta de las demás, así que no impide
  // declarar dos veces "cualquier nivel de esta base". Esa otra mitad la cubre
  // un índice único PARCIAL (WHERE nivel_id IS NULL) que vive sólo en el SQL de
  // la migración — Prisma no expresa WHERE en @@unique. Es el QUINTO índice
  // parcial invisible del proyecto (ver docs/pendientes.md).
  //
  // A diferencia de ReglaAsignacion —que dropeó su @@unique entero porque el eje
  // deleted_at atraviesa los dos alcances— acá el @@unique plano cubre completa
  // la mitad nivel_id NOT NULL y no hay soft-delete: se conserva.
  @@unique([moduloVersionId, baseConocimientoId, nivelId])
  @@map("modulo_version_criterios")
}

// ReglaAsignacion: qué módulo obliga a rendir. Apunta a Modulo (el contenedor
// estable), NO a una ModuloVersion: la obligación es "este módulo", la versión
// concreta que se rinda se resuelve al momento de rendir. Es el motor de las
// Asignacion AUTOMATICA (ver AsignacionesService.recalcular).
//
// Tiene DOS ALCANCES, que conviven:
//   - puestoId presente → regla por PAR EXACTO: sólo quien ejerce ese puesto en
//     ese centro. "Soldador en YPF" puede pedir módulos distintos que "Soldador
//     en PAE" — el par sigue siendo la unidad atómica del dominio.
//   - puestoId NULL → regla de CENTRO: aplica a TODOS los puestos de ese centro,
//     la rinde cualquiera con algún par activo ahí (soldador, amolador, lo que sea).
// Un soldador de Taller alcanzado por las dos recibe los dos módulos, y un módulo
// pedido por ambas genera UNA sola asignación (recalcular() unifica en un Set).
model ReglaAsignacion {
  id            String  @id @default(uuid())
  // Nullable a propósito: null = regla de centro (ver arriba).
  puestoId      String? @map("puesto_id")
  centroCostoId String  @map("centro_costo_id")
  moduloId      String  @map("modulo_id")
  // Baja lógica: una regla no se borra, se desactiva (deja de generar obligaciones).
  activo        Boolean @default(true)

  // onDelete explícito: al ser la relación opcional, el default de Prisma pasaría
  // a SetNull, y eso es peligroso acá — borrar un puesto convertiría en silencio
  // una regla de par en una regla de CENTRO, aplicándosela a todos los puestos de
  // ese centro. Restrict mantiene el comportamiento previo (los puestos se dan de
  // baja con `activo`, no se borran).
  puesto      Puesto?     @relation(fields: [puestoId], references: [id], onDelete: Restrict)
  centroCosto CentroCosto @relation(fields: [centroCostoId], references: [id])
  modulo      Modulo      @relation(fields: [moduloId], references: [id])

  // Trazabilidad
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  // Eliminada: eje DISTINTO de `activo`. Desactivada sigue visible en el
  // backoffice y es reactivable; eliminada deja de existir a todos los efectos
  // (listado, matching de recalcular(), índices únicos). La fila no se borra
  // nunca: es la única evidencia de por qué alguien tuvo que rendir un módulo.
  deletedAt DateTime? @map("deleted_at")

  // OJO: esta tabla NO declara ningún @@unique. Sus DOS unicidades son índices
  // únicos PARCIALES que viven sólo en el SQL de las migraciones, porque Prisma
  // no expresa WHERE en @@unique (mismo caso que el índice `principal` de
  // vinculacion_puesto_centro y el de asignación vigente única):
  //   - reglas_asignacion_par_modulo_vivas: (puesto, centro, módulo)
  //     WHERE deleted_at IS NULL. Cubre EXACTAMENTE las reglas CON puesto: con
  //     puesto_id NULL, Postgres trata cada fila como distinta de las demás.
  //   - reglas_asignacion_centro_modulo_sin_puesto: (centro, módulo)
  //     WHERE puesto_id IS NULL AND deleted_at IS NULL, la unicidad de las
  //     reglas de centro, que al índice de arriba se le escapan.
  // Los dos predicados son ortogonales: puesto_id elige QUÉ ALCANCE gobierna el
  // índice, deleted_at elige QUÉ FILAS están vivas. Volver a agregar una regla
  // dada de baja o eliminada reactiva/revive la fila (ver create()), no duplica.
  @@map("reglas_asignacion")
}

// Asignacion: obligación concreta de una persona de rendir un módulo. Apunta a
// Modulo (el contenedor estable), NO a la versión. Nunca se borra — se revoca
// (revocadaAt): una asignación revocada no cuenta como obligación vigente.
model Asignacion {
  id              String  @id @default(uuid())
  usuarioId       Int     @map("usuario_id")
  moduloId        String  @map("modulo_id")
  // Con qué versión se CUMPLIÓ esta obligación. Lo completa SesionesService.registrar()
  // al aprobar — un intento desaprobado no lo toca, y una aprobación posterior sobre
  // una versión más nueva lo pisa. null = todavía no se cumplió. No es "la última
  // versión que rindió": eso ya lo guarda cada Sesion por intento.
  moduloVersionId String? @map("modulo_version_id")

  origen     OrigenAsignacion @default(AUTOMATICA)
  // Baja de la obligación. Null = vigente. Nunca se borra la fila (trazabilidad).
  revocadaAt DateTime?        @map("revocada_at")

  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  modulo        Modulo         @relation(fields: [moduloId], references: [id])
  moduloVersion ModuloVersion? @relation(fields: [moduloVersionId], references: [id])
  sesiones      Sesion[]

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // A lo sumo UNA asignación vigente por (usuario, módulo). Se garantiza con un
  // índice único PARCIAL (WHERE revocada_at IS NULL) que vive sólo en la migración
  // — Prisma no expresa WHERE en @@unique (mismo caso que el índice `principal` de
  // vinculacion_puesto_centro). Blinda la idempotencia de recalcular() y deja
  // coexistir una asignación revocada vieja + una vigente nueva (recontratación).
  @@index([usuarioId])
  @@map("asignaciones")
}

// Sesion: UN intento de rendición de una evaluación. Es la entidad que faltaba y
// que bloqueaba las aprobaciones, el informe de usuario, los vencimientos y las
// estadísticas por base de conocimiento.
//
// Apunta a ModuloVersion y NO a Modulo: un score sólo significa algo contra la
// versión concreta que se rindió (las preguntas cambian entre versiones).
//
// INMUTABLE: es un hecho histórico, no se edita. Por eso no tiene updatedAt/
// updatedBy — mismo tratamiento que ModuloVersion y ModuloVersionCriterio.
//
// Y NO tiene deletedAt, a propósito: borrar —aunque sea lógicamente— una
// rendición cambia en silencio el historial de aprobación de una persona, y nada
// en el dominio la borra. Si algún día hace falta anular un intento (sospecha de
// copia), va como `anuladaAt` al estilo de Asignacion.revocadaAt, con
// modulosAprobados() filtrándolo — no como un soft-delete.
model Sesion {
  id String @id @default(uuid())

  usuarioId       Int     @map("usuario_id")
  moduloVersionId String  @map("modulo_version_id")
  // Qué obligación venía a cumplir. Nullable: rendir sin una asignación vigente es
  // posible (y no debe ser estructuralmente imposible), pero la sesión igual vale.
  // onDelete EXPLÍCITO porque la relación es opcional: el default de Prisma sería
  // SetNull y acá desvincularía en silencio la sesión de su obligación. Una
  // Asignacion no se borra nunca (se revoca), así que Restrict es una red que no
  // debería dispararse jamás.
  asignacionId    String? @map("asignacion_id")

  // OJO: iniciadaEn/finalizadaEn son el reloj DEL DISPOSITIVO (los manda la tablet).
  // Sirven para medir cuánto duró la evaluación y para ordenar los intentos de una
  // misma tanda, pero NO son autoritativos: con el modo offline el POST llega horas
  // después y el reloj de la tablet puede estar desfasado o mentido. La fecha
  // oficial de la rendición —trazabilidad ISO, y la vigencia cuando se implemente—
  // es `createdAt`, que lo pone el servidor.
  iniciadaEn   DateTime @default(now()) @map("iniciada_en")
  finalizadaEn DateTime @map("finalizada_en")

  // Resultado. Lo calcula SIEMPRE el backend (src/sesiones/corregir.ts) a partir de
  // las respuestas crudas: la tablet corrige local para mostrar el resultado al
  // instante, pero esa corrección es una copia, no la fuente de verdad. Es una
  // certificación de seguridad laboral — nadie se aprueba posteando aprobada: true.
  correctas        Int
  total            Int
  // El porcentaje redondeado CON EL QUE SE TOMÓ LA DECISIÓN. Se deriva de
  // correctas/total, pero el redondeo puede voltear el resultado en el borde y el
  // registro tiene que decir qué se evaluó, no obligar a reconstruirlo.
  porcentaje       Int
  // Umbral CONGELADO en la fila, no leído de una constante al mostrar el resultado:
  // si mañana se sube de 70 a 80, los certificados viejos siguen diciendo lo que
  // decían. Hoy sale de UMBRAL_APROBACION_DEFAULT; el día que el umbral sea por
  // módulo, esta columna ya soporta el cambio sin migrar nada.
  umbralAprobacion Int     @map("umbral_aprobacion")
  // La corrección se PERSISTE, no se recalcula. Compararla después contra
  // Pregunta.respuestaCorrecta haría que un cambio en el banco reescriba el pasado
  // — mismo criterio que las versiones ARCHIVADO inmutables y que la imagen de una
  // pregunta, que no se reemplaza.
  aprobada         Boolean

  // Idempotencia del POST de la Story 5: la APP genera un UUID por intento, al
  // EMPEZAR la evaluación — no la sirve el backend al armar el examen. Con
  // offline la app puede cachear un examen y rendirlo dos veces; una clave que
  // viniera del examen sería la misma en los dos intentos y el segundo se
  // perdería en silencio.
  //
  // Nullable a propósito: en Postgres un índice único admite varios NULL, así
  // que las sesiones creadas por otros caminos (seed, futuros endpoints de
  // backoffice) no quedan obligadas a tener clave.
  claveIdempotencia String? @unique @map("clave_idempotencia")

  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  moduloVersion ModuloVersion @relation(fields: [moduloVersionId], references: [id])
  asignacion    Asignacion?   @relation(fields: [asignacionId], references: [id], onDelete: Restrict)

  respuestas Respuesta[]

  // Trazabilidad
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  // NO hay unicidad sobre (usuario, moduloVersion): un reintento es simplemente una
  // fila más. Es la diferencia con Asignacion, donde el índice parcial
  // asignaciones_usuario_modulo_vigente deja a lo sumo una vigente. "¿Aprobó el
  // módulo?" es EXISTS(aprobada) sobre cualquier versión de ese módulo, y "¿cuál fue
  // el último intento?" se ordena por finalizadaEn — las dos derivadas, sin ningún
  // flag `vigente` que mantener consistente.
  @@index([usuarioId, aprobada])
  @@index([moduloVersionId])
  @@map("sesiones")
}

// Respuesta: una fila por pregunta contestada dentro de una Sesion.
//
// Se guardan las respuestas INDIVIDUALES y no sólo el score agregado, para poder
// saber en qué pregunta se falla (y así corregir preguntas malas) y para derivar
// las estadísticas por base de conocimiento. Es barato ahora e imposible
// retroactivamente.
//
// La base y el nivel NO se copian acá: se llegan por join
// (Respuesta → Pregunta → BaseConocimiento). Desnormalizarlos sería útil sólo si
// una pregunta pudiera cambiar de base, y hoy Pregunta no tiene endpoint de
// edición (el único PATCH es el toggle de papelera).
model Respuesta {
  id String @id @default(uuid())

  sesionId   String @map("sesion_id")
  preguntaId String @map("pregunta_id")

  // Lo que contestó la persona. String porque Pregunta.respuestaCorrecta lo es, y
  // en OPCIONES_IMAGEN la identidad de una opción ES la clave cruda de storage (no
  // la URL armada). Nullable = no contestó: hoy la tablet obliga a responder, pero
  // "en blanco" es un estado real y NULL lo dice sin inventar un string centinela.
  respuestaDada String? @map("respuesta_dada")
  // Corrección persistida (ver el comentario de Sesion.aprobada).
  correcta      Boolean

  sesion   Sesion   @relation(fields: [sesionId], references: [id])
  pregunta Pregunta @relation(fields: [preguntaId], references: [id])

  // Trazabilidad: sólo createdAt. Es hija de un registro inmutable y createdBy
  // repetiría el de la sesión en cada fila.
  createdAt DateTime @default(now()) @map("created_at")

  // La misma pregunta no se contesta dos veces en el mismo intento. Sin NULLs de
  // por medio, así que lo expresa Prisma y NO hace falta un sexto índice parcial
  // escrito a mano.
  @@unique([sesionId, preguntaId])
  // Para "qué preguntas se fallan más" y para el join de estadísticas por base.
  @@index([preguntaId])
  @@map("respuestas")
}

// Acción registrada en un AuditLog: alta, edición o baja de la fila auditada.
enum AccionAudit {
  CREATE
  UPDATE
  DELETE
}

// AuditLog: historial de cambios para ISO 9001 (Story 9). Registra qué cambió,
// en qué fila, quién lo hizo y cuándo — pensado para reconstruir "por qué esta
// persona tiene este par/rol/asignación hoy", no para operar sobre él.
//
// POLIMÓRFICA A PROPÓSITO: una misma tabla guarda cambios de Vinculacion,
// VinculacionPuestoCentro, y lo que se sume después — por eso `entidad` +
// `entidadId` en vez de una FK. `entidadId` es String aunque las PK reales
// sean uuid (String) o autoincrement (Int): es una EXCEPCIÓN DELIBERADA a la
// convención del resto del schema (todo lo demás usa FK tipada), no un
// descuido — una tabla polimórfica no puede tener una FK a "la entidad que
// corresponda". Consultar "el log de esta persona" es un filtro por
// (entidad, entidadId), no un join.
//
// INMUTABLE y sin soft-delete — mismo tratamiento que Sesion y ModuloVersion:
// es un hecho histórico, y borrar (aunque sea lógicamente) una fila de
// auditoría le pega directo al propósito de la tabla. Por eso no hay
// updatedAt/updatedBy/deletedAt, sólo createdAt.
//
// `actor` es String libre y no FK a Usuario: hoy los actores son los mismos
// strings genéricos que ya usa createdBy ("backoffice", "import", "tablet")
// porque no existen cuentas de sistema todavía (ver la matriz de roles en
// README.md). El día que existan, se guarda el id de esa cuenta ahí mismo,
// sin migrar nada.
//
// `diff` es jsonb con la forma `{ campo: { antes, despues } }`, SOLO los
// campos que cambiaron — no una foto completa de la fila. La forma varía por
// entidad y nunca se consulta por adentro (ni filtro ni índice sobre su
// contenido), sólo se lee entera para mostrarla: no hay razón para forzarle
// una columna tipada.
model AuditLog {
  id        String      @id @default(uuid())
  entidad   String
  entidadId String      @map("entidad_id")
  accion    AccionAudit
  diff      Json
  actor     String
  createdAt DateTime    @default(now()) @map("created_at")

  // El compuesto sirve al caso de uso real (paso 4 de esta story): "el log de
  // esta persona", filtrando por (entidad, entidadId). El de createdAt sirve
  // a un log global ordenado por fecha — no existe todavía, pero es la
  // lectura obvia siguiente y no cuesta nada adelantarlo.
  @@index([entidad, entidadId])
  @@index([createdAt])
  @@map("audit_logs")
}
