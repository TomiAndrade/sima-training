# Variables de entorno para el deploy en Render — PLANTILLA, sin valores reales.
# Este archivo SÍ se commitea. Los valores reales van en un .env.render local
# (gitignoreado) o directo en el campo "Environment" del dashboard de Render —
# nunca en un archivo versionado.
#
# El deploy de sima-training-api es MANUAL desde el dashboard de Render (no
# Blueprint), así que estas variables se cargan a mano, una por una, en la
# sección "Environment" del Web Service. Ver docs/deploy-render.md para el
# runbook completo con el paso a paso.

# --- Servidor ---

# Puerto HTTP. Render inyecta su propio PORT automáticamente — normalmente no
# hace falta setearlo a mano, pero se documenta porque el código lo lee
# (main.ts) con fallback a 3000.
PORT=10000

# Fijo en "production" para este deploy. El Dockerfile ya lo fija en el stage
# de runtime (ENV NODE_ENV=production), así que en general no hace falta
# cargarlo a mano — se documenta por si el dashboard lo pide igual.
NODE_ENV=production

# --- Base de datos (dashboard de Render → tu Postgres → pestaña "Connections") ---

# Usar la Internal Database URL si el Web Service queda en la misma región que
# la base (Ohio) — es más rápida y no tiene costo de transferencia. Si por
# algún motivo terminan en regiones distintas, usar la External Database URL.
DATABASE_URL="postgresql://usuario:password@host-interno-render:5432/nombre_db"

# --- Auth ---

# Generar un secreto random fuerte (ej. `openssl rand -base64 48`). Nunca
# reusar el default de desarrollo ("dev-secret" en auth.module.ts). Ya no lo
# usa el login del backoffice (es Auth0, ver abajo) — lo sigue usando la app
# tablet para sus propios tokens (`tipo: 'alumno'`).
JWT_SECRET="generar-un-secreto-random-fuerte"
JWT_EXPIRES_IN="8h"

# --- Auth0 (Story 4) ---
#
# JwtAuthGuard valida RS256 de Auth0 contra su JWKS. Es el único mecanismo de
# login del backoffice. Ver src/auth/jwt-auth.guard.ts.

# Dominio del tenant de Auth0 (ej. tu-tenant.us.auth0.com), sin https:// ni
# slash final.
AUTH0_DOMAIN="tu-tenant.us.auth0.com"

# Identifier de la API creada en el dashboard de Auth0.
AUTH0_AUDIENCE="tu-api-identifier"

# --- CORS ---

# Dominios reales de los frontends en producción, separados por coma, SIN
# espacios extra alrededor de las comas (aunque main.ts los recorta igual).
# Mientras no estén desplegados los frontends, dejar los de desarrollo no
# sirve de nada acá — completar cuando sima-training-backoffice y
# sima-check-app tengan su URL final.
CORS_ORIGINS="https://tu-backoffice.onrender.com,https://tu-tablet.onrender.com"

# --- Storage de archivos subidos (imágenes de preguntas) — Cloudflare R2 ---

# Obligatorio "r2" en cualquier deploy: el contenedor de Render es efímero,
# así que "local" pierde las imágenes en el primer redeploy.
STORAGE_DRIVER=r2

# Dashboard de Cloudflare → R2 → "Account Details" → Account ID (también está
# en la URL del dashboard). Con esto se arma el endpoint:
# https://<account-id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="tu-account-id-de-cloudflare"

# Dashboard de Cloudflare → R2 → "Manage API Tokens" → crear un Account API
# token con permiso "Object Read & Write" acotado al bucket. El Secret se
# muestra UNA sola vez al crearlo — guardarlo ahí mismo.
R2_ACCESS_KEY_ID="tu-access-key-id"
R2_SECRET_ACCESS_KEY="tu-secret-access-key"

# Nombre del bucket creado en Cloudflare R2.
R2_BUCKET="sima-training"

# --- Observabilidad (Sentry) ---

# DSN del proyecto de Sentry (dashboard de Sentry → Settings → Client Keys).
# Vacío o ausente = Sentry desactivado, sin romper nada.
SENTRY_DSN=""

# --- App tablet (config de producto, no son secretos) ---

# En "false", POST /tablet/login exige PIN real. Mientras esa funcionalidad
# no esté lista, dejar en "true" (o sin setear) igual que en desarrollo.
TABLET_LOGIN_SIN_PIN="true"

# Vencimiento del token de sesión de la tablet — corto a propósito, es un
# atril compartido.
TABLET_JWT_EXPIRES_IN="2h"
