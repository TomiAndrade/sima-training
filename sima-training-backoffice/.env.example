# URL de la API de SIMA Training (backend NestJS)
VITE_API_URL=http://localhost:3000

# Credenciales demo del backoffice (Sprint 1). Ya no se usan activamente
# (Story 4: el login real es Auth0, ver abajo) — quedan sin borrar porque
# client.js cae acá si nunca se registra un token getter de Auth0.
VITE_AUTH_USER=admin@sima.com
VITE_AUTH_PASSWORD=sima1234

# --- Auth0 (Story 4) ---
# Del dashboard: Applications → tu SPA → Settings (domain, client ID) y
# Applications → APIs → tu API → Settings (audience/identifier).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# DSN de Sentry (reporte de errores de render). Vacío = Sentry desactivado.
VITE_SENTRY_DSN=
