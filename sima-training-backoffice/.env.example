# URL de la API de SIMA Training (backend NestJS)
VITE_API_URL=http://localhost:3000

# --- Auth0 (Story 4) — único mecanismo de login del backoffice ---
# Del dashboard: Applications → tu SPA → Settings (domain, client ID) y
# Applications → APIs → tu API → Settings (audience/identifier).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# DSN de Sentry (reporte de errores de render). Vacío = Sentry desactivado.
VITE_SENTRY_DSN=
